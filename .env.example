# Copy to .env and fill in before `docker compose up`. Generate each secret with:
#   openssl rand -base64 32
# APP_KEYS needs two comma-separated values (no spaces), e.g. "$(openssl rand -base64 32),$(openssl rand -base64 32)".

# Public domains (must point at this server's IP via DNS for Caddy to issue TLS certs)
SITE_DOMAIN=www.example.com
CMS_DOMAIN=cms.example.com

# Strapi secrets (config/*.js in cms/app read these) — do not reuse the values from
# cms/app/.env.example, generate fresh ones for production.
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_ENCRYPTION_KEY=
